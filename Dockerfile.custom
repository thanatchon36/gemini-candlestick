# Use the official Python 3.12 image from the Docker Hub
FROM python:3.12

# Set environment variables to avoid user prompts during package installation
ENV DEBIAN_FRONTEND=noninteractive

# Install dependencies required for TA-Lib
RUN apt-get update && \
    apt-get install -y build-essential \
                       libta-lib0 \
                       libta-lib-dev \
                       wget && \
    rm -rf /var/lib/apt/lists/*

# Install the TA-Lib Python package
RUN pip install TA-Lib

# Set the working directory in the container
WORKDIR /app

# Copy the current directory contents into the container at /app
COPY . /app

# Run a simple test script to verify the installation
CMD ["python", "-c", "import talib; print(talib.__version__)"]
